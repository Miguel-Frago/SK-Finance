APP_NAME="SK Financial Tracking"
APP_ENV=local
APP_KEY=PASTE_YOUR_EXISTING_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://sk-finance.test
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Emails (secret codes, approvals). "log" writes them to storage/logs/laravel.log, handy for testing on your PC.
# For real emails use Gmail: MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
# MAIL_USERNAME=your@gmail.com, MAIL_PASSWORD=<a Google "app password">, MAIL_FROM_ADDRESS=your@gmail.com
MAIL_MAILER=log
MAIL_FROM_ADDRESS="skfinance@example.com"
MAIL_FROM_NAME="SK Finance"

# --- SK Treasurer account (used by TreasurerSeeder) ---
SK_TREASURER_NAME=""
SK_TREASURER_EMAIL=""
SK_TREASURER_PASSWORD=""

SK_CHAIRMAN_NAME=""
SK_CHAIRMAN_EMAIL=""
SK_CHAIRMAN_PASSWORD=""

# Which barangay the seeders put the Treasurer / Chairman account in (slug of the barangay name)
SK_BARANGAY="cantoria-no-4"

# --- The first Admin (SK Federation President). Only used once by: php artisan db:seed --class=AdminSeeder
# The Admin must choose their own password at the first sign-in; after that, manage the account in Admin > My profile.
SK_ADMIN_NAME=""
SK_ADMIN_EMAIL=""
SK_ADMIN_PASSWORD=""
SK_ADMIN_REPLY_TO=""

# Receipts on one expense: how many files, the size of one file, and the size of all of them together (MB)
SK_ATTACH_MAX_FILES=5
SK_ATTACH_MAX_MB=5
SK_ATTACH_TOTAL_MB=15

# Messaging: files in chats. One file (MB), files in one message, people in one group, hours before an unsent upload is removed.
# For 50 MB files PHP must allow it too: upload_max_filesize = 64M and post_max_size = 64M (Laravel Herd: Herd > PHP settings).
SK_MSG_MAX_FILE_MB=50
SK_MSG_MAX_FILES=10
SK_MSG_MAX_GROUP=500
SK_MSG_PENDING_HOURS=24

# Backups (php artisan sk:backup, every night at 02:00 when the scheduler runs): how many zips to keep
SK_BACKUP_KEEP=14
